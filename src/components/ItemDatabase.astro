---
// A complete, filterable list of items: one card per item with its icon, name
// and a short line under it. Filter chips by group and a search box narrow the
// list; hovering, focusing or tapping a card opens the item's tooltip.
import ItemIcon from './ItemIcon.astro';
import { tooltipKey } from '../lib/items';

export interface Entry {
  name: string;
  unique?: boolean;
  /** Short line under the name, e.g. the base type or gem tags. */
  sub?: string;
  /** Filter chip this item belongs to. */
  group: string;
}

export interface Props {
  entries: Entry[];
  /** Chip order. Defaults to the groups sorted by name. */
  groups?: string[];
  /** Noun for the count line, e.g. "gem" → "245 gems". */
  noun: string;
  searchHint?: string;
}

const { entries, noun, searchHint = 'Name' } = Astro.props;
const present = new Set(entries.map((e) => e.group));
const groups = (Astro.props.groups ?? [...present].sort()).filter((g) => present.has(g));
const chip =
  'rounded-full border border-border bg-surface px-3 py-1 text-sm hover:border-accent aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-accent-fg';
const plural = (n: number) => `${n} ${noun}${n === 1 ? '' : 's'}`;
---

<div data-item-db data-noun={noun} class="mt-6">
  {
    groups.length > 1 && (
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter">
        <button type="button" class={chip} data-group="" aria-pressed="true">
          All ({entries.length})
        </button>
        {groups.map((g) => (
          <button type="button" class={chip} data-group={g} aria-pressed="false">
            {g} ({entries.filter((e) => e.group === g).length})
          </button>
        ))}
      </div>
    )
  }
  <label class="mt-4 flex max-w-md flex-col text-sm font-semibold">
    Search
    <input
      data-search
      type="search"
      placeholder={searchHint}
      class="mt-1 rounded-md border border-border bg-surface px-2 py-1.5 font-normal"
    />
  </label>
  <p data-count class="mt-3 text-sm text-muted" aria-live="polite">{plural(entries.length)}</p>

  <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
    {
      entries.map((e) => (
        <li data-card data-group={e.group} data-text={`${e.name} ${e.sub ?? ''}`.toLowerCase()}>
          <button
            type="button"
            data-item={tooltipKey(e.name, e.unique)}
            class="flex h-full w-full cursor-help flex-col items-center gap-2 rounded-xl border border-border bg-surface p-3 text-center transition hover:-translate-y-0.5 hover:border-accent"
          >
            <ItemIcon name={e.name} unique={e.unique} size={72} tooltip={false} />
            <span class:list={['text-sm font-semibold leading-tight', e.unique && 'text-[#e0954a] light:text-[#9a4f0c]']}>
              {e.name}
            </span>
            {e.sub && <span class="text-xs text-muted">{e.sub}</span>}
          </button>
        </li>
      ))
    }
  </ul>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-item-db]')) {
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('button[data-group]')];
    const search = root.querySelector<HTMLInputElement>('[data-search]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const noun = root.dataset.noun!;
    let group = '';
    const apply = () => {
      const q = search.value.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const visible = (!group || card.dataset.group === group) && (!q || card.dataset.text!.includes(q));
        card.hidden = !visible;
        if (visible) shown++;
      }
      count.textContent = `${shown} ${noun}${shown === 1 ? '' : 's'}`;
    };
    for (const b of buttons) {
      b.addEventListener('click', () => {
        group = b.dataset.group ?? '';
        for (const other of buttons) other.setAttribute('aria-pressed', String(other === b));
        apply();
      });
    }
    search.addEventListener('input', apply);
  }
</script>
