---
import { SITE } from '../config';
import type { Crumb } from './Breadcrumbs.astro';

export interface Props {
  title: string;
  description: string;
  breadcrumbs?: Crumb[];
  /** Adds Article JSON-LD. */
  article?: { dateModified: Date };
  noindex?: boolean;
}

const { title, description, breadcrumbs = [], article, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Matches the file scripts/build-og.mjs writes for this page.
const ogPath = Astro.url.pathname.replace(/^\/|\/$/g, '') || 'index';
const ogImage = new URL(`/og/${ogPath}.png`, Astro.site).href;
const fullTitle = Astro.url.pathname === '/' ? `${SITE.name}: ${SITE.tagline}` : `${title} | ${SITE.name}`;

const jsonLd: Record<string, unknown>[] = [];
if (article) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    dateModified: article.dateModified.toISOString(),
    mainEntityOfPage: canonical.href,
    inLanguage: SITE.locale,
    author: { '@type': 'Organization', name: SITE.name },
    publisher: { '@type': 'Organization', name: SITE.name },
  });
}
if (breadcrumbs.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: crumb.label,
      item: new URL(crumb.href, Astro.site).href,
    })),
  });
}
if (Astro.url.pathname === '/') {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: new URL('/', Astro.site).href,
    potentialAction: {
      '@type': 'SearchAction',
      target: `${new URL('/search/', Astro.site).href}?q={query}`,
      'query-input': 'required name=query',
    },
  });
}
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical.href} />
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="theme-color" content="#100e0c" />
<meta name="generator" content={Astro.generator} />

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${title}, ${SITE.name}`} />
{article && <meta property="article:modified_time" content={article.dateModified.toISOString()} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />

{jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />)}
