<button
  type="button"
  id="theme-toggle"
  class="inline-flex h-10 w-10 items-center justify-center rounded-md border border-border text-muted hover:text-fg"
  aria-label="Switch to light theme"
>
  <svg class="h-5 w-5 light:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg class="hidden h-5 w-5 light:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
</button>

<script>
  const button = document.getElementById('theme-toggle')!;
  const sync = () => {
    const light = document.documentElement.classList.contains('light');
    button.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
  };
  sync();
  button.addEventListener('click', () => {
    const light = document.documentElement.classList.toggle('light');
    try {
      localStorage.setItem('theme', light ? 'light' : 'dark');
    } catch {
      // Storage blocked: the choice simply won't persist.
    }
    sync();
  });
</script>
