---
import type { MarkdownHeading } from 'astro';

export interface Props {
  headings: MarkdownHeading[];
}
const headings = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  headings.length > 1 && (
    <nav aria-label="On this page" class="text-sm" data-pagefind-ignore>
      <details class="rounded-lg border border-border bg-surface p-4 lg:border-0 lg:bg-transparent lg:p-0" open>
        <summary class="cursor-pointer font-semibold lg:pointer-events-none lg:list-none">On this page</summary>
        <ul class="mt-3 space-y-2 border-l border-border">
          {headings.map((h) => (
            <li class:list={[h.depth === 3 ? 'pl-6' : 'pl-3']}>
              <a href={`#${h.slug}`} class="text-muted hover:text-accent">{h.text}</a>
            </li>
          ))}
        </ul>
      </details>
    </nav>
  )
}
