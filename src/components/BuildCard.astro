---
import { getEntry, type CollectionEntry } from 'astro:content';
import Card from './Card.astro';
import PatchBadge from './PatchBadge.astro';
import RatingBars from './RatingBars.astro';

export interface Props {
  entry: CollectionEntry<'builds'>;
}
const { entry } = Astro.props;
const d = entry.data;
const [cls, asc] = await Promise.all([getEntry(d.class), getEntry(d.ascendancy)]);
const tags = [`${d.budget} budget`, d.playstyle, d.leagueStarter && 'League starter', d.ssfFriendly && 'SSF friendly'].filter(Boolean);
---

<Card href={`/builds/${entry.id}/`} class="h-full">
  <div class="flex items-start justify-between gap-3">
    <h3 class="text-lg font-semibold">{d.title}</h3>
    <span class="shrink-0 rounded border border-accent px-1.5 text-xs font-bold text-accent" title="Tier (our opinion)">{d.tier}</span>
  </div>
  <p class="mt-1 text-sm text-muted">{d.mainSkill} · {asc.data.title} ({cls.data.title})</p>
  <ul class="mt-3 flex flex-wrap gap-1.5 text-xs">
    {tags.map((t) => <li class="rounded bg-surface-2 px-2 py-0.5 capitalize">{t}</li>)}
  </ul>
  <div class="mt-4"><RatingBars ratings={d.ratings} /></div>
  <div class="mt-3"><PatchBadge patch={d.patch} status={d.status} /></div>
</Card>
