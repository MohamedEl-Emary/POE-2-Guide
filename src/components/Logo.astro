---
// Site logo (public/logo.webp, 2x for a 48px-tall header). Source image supplied by Mohamed.
export interface Props {
  class?: string;
}
const { class: className = 'h-12 w-auto' } = Astro.props;
---

<picture>
  <source srcset="/logo.webp" type="image/webp" />
  <img src="/logo.png" alt="" width="117" height="96" class={className} decoding="async" fetchpriority="high" />
</picture>
